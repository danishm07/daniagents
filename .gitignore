# Secrets — never commit
.env

# Downloaded historical archive — pulled from the API, can be large.
# The folder is kept (via .gitkeep); its contents are never committed.
data/archive/*
!data/archive/.gitkeep

# Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs / tooling (uv.lock is committed on purpose)
.venv/
venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Champion column — regenerable from champion.py, but costs an API run.
# Tracked deliberately: the research is not reproducible without it.
!data/champion/

# Raw external-API caches — large, regenerable from the source APIs, and the
# same reasoning that gitignores data/archive/*. The DERIVED feature tables in
# data/blocks/ ARE committed: they are the cycle's deliverable and cost real
# fetches to rebuild.
data/edgar/
data/prices/
data/flow/
data/estimates/
data/options/
