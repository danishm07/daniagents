# Copy this file to `.env` and fill it in:  cp .env.example .env
# The notebooks and scripts load `.env` automatically (via python-dotenv).
# `.env` is gitignored — never commit your real credentials.

# ── Required for live API calls ──────────────────────────────────────────
# Your submission's API key, from the portal's Credentials tab. Sent as the
# `X-API-Key` header. Without it, the notebooks fall back to bundled sample
# data so you can still run them top-to-bottom offline.
EM_API_KEY=

# ── Optional ── only for the summarizer demo ──────────────────────────────
# notebooks/02_earnings_call_facts.ipynb can run the real fact-extraction call
# against Anthropic's API to show the mechanism end to end. This is NOT a
# competition credential and nothing else in this repo needs it — leave it blank
# and that one section self-skips. Get a key from console.anthropic.com.
ANTHROPIC_API_KEY=

# ── Optional ── sensible default; uncomment only to override ──────────────
# Which API stage to hit. Defaults to beta, the stage open to invite-code holders.
#   Production:   https://api.explainingmarkets.ai/v1
#   Beta:         https://api-beta.explainingmarkets.ai/v1   (default)
# EM_API_BASE_URL=https://api-beta.explainingmarkets.ai/v1
